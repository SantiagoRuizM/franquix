{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franquix-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },

  // The Spring Boot API runs as a Cloudflare Container, controlled by a Durable Object.
  // `wrangler deploy` builds ../Dockerfile (linux/amd64) and pushes it to the Cloudflare Registry.
  "containers": [
    {
      "class_name": "FranquixContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 1 GiB / 1/4 vCPU: the smallest size that fits a JVM comfortably
      "instance_type": "basic",
      // A single instance is enough for the MVP and keeps the Atlas M0 connection count low
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "FRANQUIX_CONTAINER",
        "class_name": "FranquixContainer"
      }
    ]
  },

  // Container-enabled Durable Objects must use SQLite storage
  "exports": {
    "FranquixContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // Values are never committed. MONGODB_URI is the Atlas connection string; JWT_SECRET signs access
  // tokens; ADMIN_EMAIL / ADMIN_PASSWORD create the first admin. Set each with
  // `npx wrangler secret put <NAME>` (CI uses `wrangler deploy --secrets-file`) and,
  // for `wrangler dev`, in a git-ignored .dev.vars file.
  "secrets": {
    "required": ["MONGODB_URI", "JWT_SECRET", "ADMIN_EMAIL", "ADMIN_PASSWORD"]
  }
}
