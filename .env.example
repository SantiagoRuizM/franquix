# Copy to .env and adjust. Never commit the real .env file.

# Full MongoDB connection string. Locally docker-compose provides its own value.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/franquix?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/franquix

# Database name (overrides the one in the URI path, if any)
MONGODB_DATABASE=franquix

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local

# HTTP port
PORT=8080

# --- Authentication -------------------------------------------------------------------------------
# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-0123456789

# First ADMIN, created at startup when it does not exist yet (password: 12+ chars, not common)
ADMIN_EMAIL=admin@franquix.local
ADMIN_PASSWORD=replace-with-a-strong-passphrase

# Optional overrides (defaults shown)
# ACCESS_TOKEN_TTL=5m
# REFRESH_TOKEN_TTL=1d
# RATE_LIMIT_AUTH_PER_MINUTE=5
# RATE_LIMIT_ANONYMOUS_PER_HOUR=100
# RATE_LIMIT_USER_PER_HOUR=1000
# API_DOCS_ENABLED=true
